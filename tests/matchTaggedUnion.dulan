embed `#include <stdio.h>`

const main :: none -> int = fn |

  var tagUnion :: int ^ byte ^ #byte = 'a' 

  $ pnt_func will receive the function defined inside the branch tagUnion goes
  $ only declaring dummy_func for the first value of pnt_func
  const dummy_func = fn | back {}
  var pnt_func :: #(none -> none) = #dummy_func

  $ creating a function for run the match, so we can repeat many times
  match_func = fn => none |
    match tagUnion |

      $ branch of match if tagUnion is an int
      num :: int |
        its_int = fn => none | embed `printf("it's an integer!!\n");`
        pnt_func = #its_int

      $ branch of match if tagUnion is a byte
      num :: byte |
        its_byte = fn => none | embed `printf("it's a byte!!\n");`
        pnt_func = #its_byte

      $ branch of match if tagUnion is a pointer to bytes
      str :: #byte |
        its_string = fn => none | embed `printf("it's a string!!\n");`
        pnt_func = #its_string

  $ calling the function that pnt_func get inside the match
  match_func()
  @pnt_func()

  $ changing the type of taggedUnion
  tagUnion = 1
  match_func()
  @pnt_func()

  tagUnion = "hellow world!!"
  match_func()
  @pnt_func()

  back 0
