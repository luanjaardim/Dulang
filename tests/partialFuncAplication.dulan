embed `#include<stdio.h>`

print_int = fn num :: int => none | embed `printf("%d\n", ${num});`

const main :: none -> int = fn |
  $ creating a function
  sum :: int -> int -> int = fn a, b | back a + b
  var res = 0

  $ creating a pointer to a function
  g = #sum

  $ dereferencing a pointer to a function and calling the function
  res = @g(20, 4)
  print_int(res)

  $ creating a partial function from the original function
  sum1 = sum(1)
  res = sum1(5)
  print_int(res)

  $ creating a partial function from a function pointer
  sum5 = @g(5)
  res = sum5(10)
  print_int(res)

  $ a pointer to a function pointer
  sla = #g

  $ partial application to a pointer to a pointer that points to a function...
  sla2 = @@sla(10)
  res = sla2(1000)
  print_int(res)

  back 0
