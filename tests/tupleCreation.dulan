embed `#include<stdio.h>`

print = fn a :: int ^ #byte ^ byte => none |
  match a |
    str :: #byte |
      embed `printf("it's a string: %s\n", ${str});`
    num :: int |
      embed `printf("it's an integer: %d\n", ${num});`
    char :: byte |
      embed `printf("it's a char: %c\n", ${char});`

const main :: int -> ##byte -> int = fn argc, argv |
  $ a tuple of int & byte and a tuple of int & int & int & int
  const a = {1, 'a'} ;; var b = {1, "hello world", 3, 'a'}

  $ value used to print any of the three types: int or #btye or byte
  var to_print :: int ^ #byte ^ byte = ""

  to_print = a.1        $ acessing the second element of the tupple a
  print(to_print)

  to_print = b.1        $ the second element of b
  print(to_print)

  $ a mutable reference to the second field of b
  d = #var b.1

  $ changing the second field of b
  @d = "world hello"

  to_print = b.1
  print(to_print)

  $ assign to a field of b, only possible because it was defined as var
  b.0 = 69
  to_print = b.0
  print(to_print)

  back 0
