$ the whole program is a list of statements ended with NEW_LINE('\n')
root:
  [<stmt>:BLOCK]

$ can be used inside the scope was defined, and in inner scopes
stmt:
  <func_def>
  <var_def>
  <assignment>
  <type_def>
  <if_stmt>
  <while_stmt>
  <back_stop_skip>

func_def:
  "fn" <type> NAME ?(":" [<arg>:","]) "|" <body>   $ creating a function

arg: 
  <type> NAME ?("=" <comptime_val>)

var_def:
  "var" <type> NAME "=" <expr>                     $ creating a variable
  ?("const") ?(<type>) NAME "=" <expr>             $ creating a constant, the type can be infered

assignment:
  <primary> "=" <expr>

$ TODO: cannot define a type with multiple lines
type_def:
  "type" NAME "|" <user_type>                      $ defining a user type, a name to be used to refer that type
  "type" NAME "|" <type>                           $ defining an alias to a type

if_stmt:
  "if" <expr> "|" <body>
  "if" <expr> "|" <body> "else" "|" <body>

while_stmt:
  "while" <expr> "|" <body>

$ for_stmt:

back_stop_skip:
  "back" <expr>                                    $ return point of a function
  "stop"                                           $ break point of a loop
  "skip"                                           $ restart point of a loop

$$
  body is a list of indented new_line separated statements or a just a single statement
  INDENT -> verifies if the first element collumn of each statement is indented
$$
body:
  <stmt>
  [<stmt>:NEW_LINE]

expr:
  <expr> "?" <expr> ":" <expr>
  "(" <expr> ")"
  NAME [<expr>:" "]                                $ function call
  <bitwise>

bitwise:
  <bitwise> "band" <bitwise>
  <bitwise> "bor" <bitwise>
  <bitwise> "bnot" <bitwise>
  <bitwise> "shl" <num>
  <bitwise> "shr" <num>
  <boolean>
  $ continue...

boolean:
  <boolean> "and" <boolean>
  <boolean> "or" <boolean>
  <boolean> "not" <boolean>
  <num>
  $ continue...

num:
  <num> "+" <term>
  <num> "-" <term>
  <term>

term:
  <term> "*" <factor>
  <term> "/" <factor>
  <term> "%" <factor>
  <factor>

factor:
  "-" <factor>
  "(" <expr> ")"
  <primary>
  <atom>

primary:
  <primary> "." <primary>
  "@" NAME
  NAME "@" <num>

atom:
  <var>
  <comptime_val>

comptime_val:
  NUMBER
  CHAR
  STRING

var:
  ?("#") NAME

$$
  A compound type that must have a name to it's fields and possibly a default value
$$
user_type:
  "{" [<arg>:";"] "}"

type:
  "(" <type> ")"
  "{" [<type>:";"] "}"       $ compound type, a type that is a 
  "#" <type>                 $ pointer to a type
  "?" <type>                 $ nullable pointer to a type
  "#" "[" NUMBER "]" <type>  $ array of NUMBER elements
  "#" "*" <type>             $ pointer to an array null terminated
  <type> "^" <type>          $ tagged union types
  <type> "->" <type>         $ functions types
  "byte"                     $ signed 1-byte
  "ubyte"                    $ unsigned 1-byte
  "int"                      $ signed 4-bytes
  "uint"                     $ unsigned 4-bytes
